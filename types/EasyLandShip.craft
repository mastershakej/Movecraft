name: "EasyLandShip"
maxSize: 5000
minSize: 50
allowedBlocks:
  - "#mineable/pickaxe"
  - "#mineable/axe"
  - "#mineable/shovel"
  - "#planks"
  - "#stairs"
  - "#slabs"
  - "#walls"
  - "#doors"
  - "#trapdoors"
  - "#fences"
  - "#fence_gates"
  - "furnace"
  - "blast_furnace"
  - "smoker"
  - "glass"
  - "glass_pane"
  - "iron_block"
  - "redstone_block"
forbiddenBlocks:
  - "bedrock"
canCruise: false
canFly: false
rotateAtMidpoint: true
canSwitchWorld: false
canBeNamed: true
canDirectControl: true
speed: 0.35
parent: "LandShipBase"
movecraft:
  general:
    name: "EasyLandShip"
  movement:
    speed:
      speed: 0.32
  constraints:
    size:
      min: 50
      max: 5000
    must_be_subcraft: false
    block:
      move_blocks:
        - ==: Movecraft_RequiredBlockEntry
          displayName: "Engines"
          min: 0.02
          max: 100.0
          blocks:
            - "#eool:engines"
  fuel:
    burn_rate: 0.0
    passive_burn_rate: 0.0
  sinking:
    lowest_possible_integrity: 65.0

movecraft-eool-additions:
  horn:
    volume:
      min: 0.05
      max: 0.40
    max_distance: 80
