name: "EasyAirShip"
maxSize: 5000
minSize: 100
allowedBlocks:
  - "#eool:movecraft_craft_blocks/airship"
  - "#eool:movecraft_craft_blocks/subcraft"
  - "#eool:movecraft_craft_blocks/skiff"
forbiddenBlocks:
  - "bedrock"
canCruise: true
canFly: true
rotateAtMidpoint: true
canSwitchWorld: true
canBeNamed: true
canDirectControl: true
speed: 1
parent: "AirShipBase"
movecraft:
  general:
    name: "EasyAirShip"
  constraints:
    size:
      min: 100
      max: 5000
    must_be_subcraft: false
    block:
      flyblocks: []
      detection_blocks: []
      move_blocks:
        - ==: Movecraft_RequiredBlockEntry
          displayName: "Engines"
          min: 0.02
          max: 100.0
          blocks:
            - "#eool:engines"
  fuel:
    burn_rate: 0.0
    passive_burn_rate: 0.0
  sinking:
    lowest_possible_integrity: 90.0

movecraft-eool-additions:
  horn:
    volume:
      min: 0.05
    max_distance: 60
