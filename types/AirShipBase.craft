name: "AirShipBase"
maxSize: 200000
minSize: 100
allowedBlocks:
  - "#eool:movecraft_craft_blocks/airship"
  - "#eool:movecraft_craft_blocks/subcraft"
  - "#eool:movecraft_craft_blocks/skiff"
forbiddenBlocks:
  - "bedrock"
canCruise: true
canFly: true
rotateAtMidpoint: true
canSwitchWorld: true
canBeNamed: true
canDirectControl: true
speed: 1
parent: ""
movecraft:
  general:
    name: "AirShipBase"
    block:
      allowed:
        - "#eool:movecraft_craft_blocks/airship"
        - "#eool:movecraft_craft_blocks/subcraft"
        - "#eool:movecraft_craft_blocks/skiff"
      #directional:
      forbidden:
        - "minecraft:bedrock"
    can_switch_world: true
    can_be_named: true
    rotate_at_midpoint: true
    merge_piston_extensions: true
    release_timeout: 1000
  #disabled_state:
    #allow_block_breaking_when_disabled: true
    #require_disabled_to_break_blocks: true
    #can_be_un_disabled: true
  movement:
    #chest_penalty:
    speed:
      speed: 1.00
      modifiers:
        max_speed: 8.0
        blocks:
          ==: Movecraft_NamespacedKeyToDoubleProperty
          "#eool:heavy_armor": -10.0
          #oldschool armor is 50% less heavy
          "#eool:oldschool_armor": -5.0
          #Firebrakes share the same weight
          "#eool:fire_brakes": -5.0
          #super armor is 50% heavier
          "#eool:super_armor": -15.0
          #Munitions, dispensers, droppers, hoppers are 25% heavier than heavy armor
          "#eool:munitions": -25.0
          "minecraft:dispenser": -12.5
          "minecraft:dropper": -6.25
          "minecraft:hopper": -3.125
          #If the ship is at least 30% hull block, it will have full speed
          "#eool:light_armor": 20.0
          #Engines give speed too, but not a lot (75% of what a hull block gives)
          "#eool:engines": 15.0
    cruise:
      enabled: true
      skip_blocks: 7
      vert_skip_blocks: 2
      # WARNING: Setting this to absolute 0 will cause the conversion into cruiseTickCooldown to produce weird values
      # Will lead to crafts not properly behaving
      speed: 0.01
      vert_speed: 0.25
    move_break_blocks:
      - "#eool:craft_move_break_blocks"
    passthrough_blocks:
      - "#eool:foliage"
      - "minecraft:cave_air"
    collision:
      explosion:
        focused: false
        #arming_time: 1000
        #strength: 0.0
        #underwater_strength: 0.0
        allow_internal: true
      sound:
        ==: Movecraft_ConfiguredSound
        Sound: "block.anvil.land"
        Category: "NEUTRAL"
        MinVolume: 2.0
        MaxVolume: 2.0
        MinPitch: 1.0
        MaxPitch: 1.0
    can_direct_control: true
    entities:
      enabled: true
      only_players: false
    gravity:
      enabled: false
      incline_distance: -1
      drop_distance: -8
    controller:
      rotation:
        ==: Movecraft_DefaultRotationController
        TurningEnabled: true
  teleport:
    enabled: false
    #disabled_destination_worlds:
    #cooldown:
  constraints:
    size:
      max: 200000
      min: 100
    buoyancy:
      enabled: true
      base_lift_per_block: -1.0
      min_net_lift: 0.0
      block_lift_modifiers:
        ==: Movecraft_NamespacedKeyToDoubleProperty
        "#eool:flyblocks": 2.0
        "#eool:wooden_flyblocks": 0.75
        "#eool:trapdoor_flyblocks": 0.25
        "#eool:light_armor": 0.15
        "#eool:engines": 0.25
        "#eool:heavy_armor": -1.5
        "#eool:oldschool_armor": -0.9
        "#eool:super_armor": -2.2
        "#eool:munitions": -2.8
        "minecraft:water": -1.0
        "minecraft:lava": -0.9
    #require_water_contact:
    allow_remote_sign: true
    must_be_subcraft: true
    can_be_subcraft: false
    movement:
      #required_contact_blocks:
      #traction_blocks:
      #hover:
        #enabled: false
        #forbidden_blocks:
        #limit: 0
      allow_vertical: true
      allow_horizontal: true
      static_move:
        enabled: false
        max: 1
      height_limit:
        min: 0
        max: 300
      max_ground_distance: 300
      allow_vertical_takeoff_and_landing: true
    #forbidden_sign_strings:
    block:
      flyblocks:
        - ==: Movecraft_RequiredBlockEntry
          displayName: "Fleep"
          min: 0.0
          max: 100.0
          blocks:
            - "#eool:flyblocks"
            - "#eool:fire_brakes"
        - ==: Movecraft_RequiredBlockEntry
          displayName: "Armor"
          min: 0.0
          max: 100.0
          blocks:
            - "#eool:heavy_armor"
            - "#eool:super_armor"
            - "#eool:oldschool_armor"
            - "minecraft:dispenser"
        - ==: Movecraft_RequiredBlockEntry
          displayName: "Guns"
          min: 0.0
          max: 100.0
          blocks:
            - "minecraft:dispenser"
            - "minecraft:dropper"
            - "minecraft:hopper"
        - ==: Movecraft_RequiredBlockEntry
          displayName: "Super armor"
          min: 0.0
          max: 100.0
          blocks:
            - "#minecraft:anvil"
            - "#eool:super_armor"
        - ==: Movecraft_RequiredBlockEntry
          displayName: "Water"
          min: 0.0
          max: 100.0
          blocks:
            - "minecraft:water"
            - "minecraft:lava"
      detection_blocks:
        - ==: Movecraft_RequiredBlockEntry
          displayName: "Wooden flyblocks"
          min: 0.0
          max: 45.0
          blocks:
            - "#eool:wooden_flyblocks"
        - ==: Movecraft_RequiredBlockEntry
          displayName: "Trapdoor flyblocks"
          min: 0.0
          max: 20.0
          blocks:
            - "#eool:trapdoor_flyblocks"
        - ==: Movecraft_RequiredBlockEntry
          displayName: "Firebrakes"
          min: 0.0
          max: 5.0
          blocks:
            - "#eool:fire_brakes"
        - ==: Movecraft_RequiredBlockEntry
          displayName: "Chests"
          min: 0.0
          max: 1.0
          blocks:
            - "#minecraft:chests"
        - ==: Movecraft_RequiredBlockEntry
          displayName: "Furnaces"
          min: 0.0
          max: 200
          blocks:
            - "#minecraft:smelter"
        - ==: Movecraft_RequiredBlockEntry
          displayName: "Soulsand"
          min: 0.0
          max: 0.5
          blocks:
            - "minecraft:soul_sand"
      move_blocks:
        - ==: Movecraft_RequiredBlockEntry
          displayName: "Engines"
          min: 1.0
          max: 100.0
          blocks:
            - "#eool:engines"
  #harvester:
    #breakable_blocks:
    #harvester_blocks:
  #dynamic_lag:
    #speed_factor:
    #power_factor: 
    #min_speed:
    #block_speed_factor:
  static_water_level: 62
  fuel:
    burn_rate: 1.0
    furnace_visualization: true
    passive_burn_rate: 0.25
    types:
      ==: Movecraft_NamespacedKeyToDoubleProperty
      "minecraft:coal_block": 80
      "minecraft:coal": 8
      "minecraft:charcoal": 8
  contacts:
    detection:
      multiplier: 10.0
      underwater_multiplier: 1.0
    new_contact_sound:
      ==: Movecraft_ConfiguredSound
      Sound: "block.note_block.bit"
      Category: "PLAYERS"
      MinVolume: 1.0
      MaxVolume: 1.0
      MinPitch: 1.20
      MaxPitch: 1.30
  #gear_shifts:
    #count:
    #modify:
      #tick_cooldown:
      #direct_movement:
      #cruise_skip_blocks:
  sinking:
    #Old sinkpercent!
    constraint_intolerance: 100.0
    #Old overall sinkpercent!
    lowest_possible_integrity: 80.0
    sink_rate_ticks: 20
    keep_moving: false
    sink_on_out_of_fuel: false
    smoke: 0
    explosion:
      strength: 0.0
      incendiary: false
    falling_block_chance: 0.2
    pretty:
      enabled: true
      max_remaining_percentage: 1.0
      disintegration:
        delay: 0
        chance: 0.5
        min: 5
        max: 10
        #sound:
      explosion:
        chance: 0.25
        min: 4
        max: 8
#movecraft-shiprules:
#  max_length_to_height_ratio: 1
#  require_cruise_sign_alignment: false
#  min_length_to_width_ratio: 0.5
#  max_length_to_width_ratio: 1.0
#  min_length_to_height_ratio: 0.5
#  min_width_to_height_ratio: 0.5
#  max_width_to_height_ratio: 1.0
#  min_absolute_width: 10
#  max_absolute_width: 20
#  min_absolute_length: 10
#  max_absolute_length: 20
#  min_absolute_height: 10
#  max_absolute_height: 20
movecraft-bridges:
  allow_bridge_signs: true
movecraft-combat:
  #Tracers
  movement_tracer_blocks:
    - "#eool:engines"
    - "minecraft:fire"
  movement_tracer_chance: 0.5
  max_movement_tracers: 200
  #Directors
  allow_aa_director_sign: true
  #max_aa_director_angle: 45.0
  allow_arrow_director_sign: true
  #max_arrow_director_angle: 45.0
  allow_cannon_director_sign: true
  #max_cannon_director_angle: 45.0
movecraft-eool-additions:
  #BlastPowerOverride
  #tnt_blast_power_override: 6.0
  #Command Restrictor
  enforce_command_restrictions: true
  #Sounds
  horn:
    enabled: true
    sound: "movecraft.honk.dreadnought"
    volume:
      min: 0.1
      max: 0.9
    size:
      scaling: 0.1
      divisor: 5000
    max_distance: 100
    min_cooldown: 120
  #Cruise rework
  engines_define_cruise_direction: true
  ignore_during_subcraft_detection:
    - LaunchBomb
    - LaunchTorpedo
    - Turret
    - TurretS
    - TurretC
    - TurretM
    - TurretDD
    - BombHatch
    - Elevator
    - Lightairship
    - SmallAirship
    - AirShipBase
    - BigAirship
    - MegaAirship
    - Ultrairship
    - GigAirship
    - CargoAirship
    - HeavyAirship
  #Warheads
  #Movement
  rudders:
    elevator:
      enabled: true
      angle:
        min: -20.0
        max: 20.0
        step: 2
