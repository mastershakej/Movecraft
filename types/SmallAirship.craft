name: "SmallAirship"
maxSize: 9000
minSize: 3000
allowedBlocks:
  - "#eool:movecraft_craft_blocks/airship"
  - "#eool:movecraft_craft_blocks/subcraft"
  - "#eool:movecraft_craft_blocks/skiff"
forbiddenBlocks:
  - "bedrock"
canCruise: true
canFly: true
rotateAtMidpoint: true
canSwitchWorld: true
canBeNamed: true
canDirectControl: true
speed: 1
parent: "AirShipBase"
movecraft:
  general:
    name: "SmallAirship"
  movement:
    cruise:
      skip_blocks: 6
      vert_speed: 0.35
  constraints:
    size:
      max: 9000
      min: 3000
  sinking:
    constraint_intolerance: 100.0
    lowest_possible_integrity: 85.0
    pretty:
      disintegration:
        min: 3
        max: 6
      explosion:
        min: 2
        max: 4
movecraft-eool-additions:
